# ==============================================================================
# Task Manager Pro — Production Environment Variables Template
# Copy this file to .env.production and customize with your secret values
# ==============================================================================

# --- Application Runtime ---
NODE_ENV=production
APP_PORT=3001
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# --- PostgreSQL Database ---
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=task_manager
DATABASE_USER=postgres_user
DATABASE_PASSWORD=strong_postgres_password_2026!
DATABASE_LOGGING=false
RUN_MIGRATIONS=true

# --- Redis Cache & Broker ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT Authentication Secrets ---
# Generate using: openssl rand -base64 48
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_access_secret_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_cryptographically_secure_random_string_refresh_secret_2026
JWT_REFRESH_EXPIRES_IN=7d

# --- Background Worker & Processing ---
RUN_WORKERS=true

# --- SMTP Email Delivery (Gmail, AWS SES, Mailgun, SendGrid, Postmark) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_or_ses_smtp_password
SMTP_SECURE=false
SMTP_FROM="Task Manager Pro" <noreply@yourdomain.com>

# --- Storage Configuration ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/uploads

# --- Rate Limiting (Requests per minute) ---
THROTTLE_TTL=60
THROTTLE_LIMIT=120
