{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "api/index.ts",
      "installCommand": "npm install --legacy-peer-deps",
      "functions": {
        "api/index.ts": {
          "includeFiles": "node_modules/**"
        },
        "index.js": {
          "includeFiles": "node_modules/**"
        },
        "main.js": {
          "includeFiles": "node_modules/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
