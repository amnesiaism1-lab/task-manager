    folder "src/database/migrations" as mig
    folder "src/modules/identity"
    folder "src/modules/organization"
    folder "src/modules/project"
    folder "src/modules/board"
    folder "src/modules/sprint"
    folder "src/modules/workflow"
    folder "src/modules/issue\n(aggregate + collab only)" as issuemod
    folder "src/modules/custom-field"
    folder "src/modules/search"
    folder "src/modules/configuration"
    folder "src/modules/security-scheme"
    folder "src/modules/notification"
    folder "src/modules/audit"
    folder "src/modules/outbox"
    folder "src/modules/job"
    folder "src/modules/productivity"
    folder "src/modules/automation"
    folder "src/modules/integration"
    folder "src/modules/storage"
    folder "src/modules/mail"
