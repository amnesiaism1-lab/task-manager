# ============================================
# Task Manager — Environment Variables
# ============================================

# --- Application ---
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=task_manager
DATABASE_USER=dev
DATABASE_PASSWORD=dev_password
DATABASE_URL=postgresql://dev:dev_password@localhost:5432/task_manager
DATABASE_SSL=false
DATABASE_LOGGING=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- JWT / Auth ---
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRATION=7d

# --- Email ---
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@taskmanager.dev

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
RUN_WORKERS=false
