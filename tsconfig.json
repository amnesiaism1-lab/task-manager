{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@task-manager/shared": ["./shared/src/index.ts"],
      "@/*": ["./frontend/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".vercel"]
}
