@startuml
' Task Manager (Jira-like) — ERD template
' Focus: Workflow/FSM + RBAC + audit history + event-driven + concurrency (optimistic version)
' NOTE: issue_types (org-scoped) is declared in Issues package but referenced by
'       workflow_scheme_mappings in Workflow package — forward reference, same org as project (C-11)

left to right direction
hide circle
skinparam linetype ortho

' =========================
' Identity / Organization
' =========================
package "Identity & Org" {
  entity "organizations" as organizations {
    * id : UUID <<PK>>
    --
    key : VARCHAR <<UQ>>
    name : VARCHAR
    plan : VARCHAR
    status : VARCHAR
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "users" as users {
    * id : UUID <<PK>>
    --
    email : VARCHAR <<UQ>>
    password_hash : VARCHAR
    full_name : VARCHAR
    avatar_url : VARCHAR
    status : VARCHAR
    email_verified_at : TIMESTAMP
    last_login_at : TIMESTAMP
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "organization_members" as org_members {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    user_id : UUID <<FK users.id>>
    ' invited | active | suspended
    status : VARCHAR
    title : VARCHAR
    joined_at : TIMESTAMP
    invited_by_member_id : UUID <<FK organization_members.id>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, user_id)
  }

  entity "organization_invitations" as org_invitations {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    email : VARCHAR
    invited_by_member_id : UUID <<FK organization_members.id>>
    org_role_id : UUID <<FK org_roles.id>>
    token_hash : VARCHAR <<UQ>>
    ' pending | accepted | revoked | expired
    status : VARCHAR
    expires_at : TIMESTAMP
    accepted_by_user_id : UUID <<FK users.id>>
    accepted_at : TIMESTAMP
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, email) WHERE status=pending
    ' C-25: inviter and optional org role must belong to org_id
    ' Invitation may exist before the invited email has a users row
  }

  entity "org_roles" as org_roles {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    key : VARCHAR
    name : VARCHAR
    description : TEXT
    created_at : TIMESTAMP
    ' UQ(org_id, key)
  }

  entity "org_member_roles" as org_member_roles {
    * org_member_id : UUID <<FK organization_members.id>>
    * role_id : UUID <<FK org_roles.id>>
    --
    granted_at : TIMESTAMP
    granted_by_member_id : UUID <<FK organization_members.id>>
    ' C-28: member, role and grantor belong to the same organization
  }

  entity "org_role_permission_entries" as org_role_permission_entries {
    * role_id : UUID <<FK org_roles.id>>
    * permission_key : VARCHAR
    --
    ' e.g., MANAGE_ORG, MANAGE_USERS, CREATE_PROJECT
    created_at : TIMESTAMP
  }

  entity "departments" as departments {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    name : VARCHAR
    description : TEXT
    parent_department_id : UUID <<FK departments.id>>
    lead_member_id : UUID <<FK organization_members.id>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, name)
    ' C-28: parent_department and lead_member must belong to the same organization
  }

  entity "department_members" as department_members {
    * department_id : UUID <<FK departments.id>>
    * org_member_id : UUID <<FK organization_members.id>>
    --
    role_in_department : VARCHAR
    joined_at : TIMESTAMP
    ' C-29: department and member belong to the same organization
  }

  entity "groups" as groups {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    name : VARCHAR
    description : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, name)
  }

  entity "group_members" as group_members {
    * group_id : UUID <<FK groups.id>>
    * org_member_id : UUID <<FK organization_members.id>>
    --
    added_at : TIMESTAMP
    added_by_member_id : UUID <<FK organization_members.id>>
    ' C-30: group, member and added_by belong to the same organization
  }
}

' =========================
' Security / Authentication
' =========================
package "Security & Authentication" {
  entity "auth_sessions" as auth_sessions {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK users.id>>
    refresh_token_hash : VARCHAR <<UQ>>
    ' active | revoked | expired
    status : VARCHAR
    ip_address : VARCHAR
    user_agent : TEXT
    expires_at : TIMESTAMP
    last_seen_at : TIMESTAMP
    revoked_at : TIMESTAMP
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "password_reset_tokens" as password_reset_tokens {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK users.id>>
    token_hash : VARCHAR <<UQ>>
    expires_at : TIMESTAMP
    used_at : TIMESTAMP
    created_at : TIMESTAMP
    ' Token is single-use and stored hashed; IDX(user_id, expires_at)
  }

  entity "email_verification_tokens" as email_verification_tokens {
    * id : UUID <<PK>>
    --
    user_id : UUID <<FK users.id>>
    email : VARCHAR
    token_hash : VARCHAR <<UQ>>
    expires_at : TIMESTAMP
    used_at : TIMESTAMP
    created_at : TIMESTAMP
    ' Token is single-use and stored hashed; IDX(user_id, expires_at)
  }
}

' =========================
' Projects / Boards / Sprints
' =========================
package "Workspace" {
  entity "projects" as projects {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    key : VARCHAR
    name : VARCHAR
    description : TEXT
    ' private | org | public
    visibility : VARCHAR
    department_id : UUID <<FK departments.id>>
    permission_scheme_id : UUID <<FK permission_schemes.id>>
    workflow_scheme_id : UUID <<FK workflow_schemes.id>>
    issue_type_scheme_id : UUID <<FK issue_type_schemes.id>>
    priority_scheme_id : UUID <<FK priority_schemes.id>>
    field_scheme_id : UUID <<FK field_schemes.id>>
    issue_type_screen_scheme_id : UUID <<FK issue_type_screen_schemes.id>>
    issue_security_scheme_id : UUID <<FK issue_security_schemes.id>>
    notification_scheme_id : UUID <<FK notification_schemes.id>>
    created_by_member_id : UUID <<FK organization_members.id>>
    next_issue_number : BIGINT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    archived_at : TIMESTAMP
    ' UQ(org_id, key)
    ' C-01: project-owned selected schemes must belong to this project
    ' C-35: org-scoped selected schemes must belong to project.org_id
    ' Core schemes are nullable only during setup; extension schemes require seeded defaults when phase 2 is enabled
    ' CHECK(next_issue_number >= 1); atomically increment to allocate issue keys
  }

  entity "project_roles" as project_roles {
    * id : UUID <<PK>>
    --
    project_id : UUID <<FK projects.id>>
    key : VARCHAR
    name : VARCHAR
    description : TEXT
    created_at : TIMESTAMP
    ' UQ(project_id, key)
  }

  entity "project_members" as project_members {
    * id : UUID <<PK>>
    --
    project_id : UUID <<FK projects.id>>
    org_member_id : UUID <<FK organization_members.id>>
    ' active | removed
    status : VARCHAR
    joined_at : TIMESTAMP
    created_at : TIMESTAMP
    ' UQ(project_id, org_member_id)
    ' INVARIANT: org_member.org_id = project.org_id
  }

  entity "project_member_roles" as project_member_roles {
    * project_member_id : UUID <<FK project_members.id>>
    * project_role_id : UUID <<FK project_roles.id>>
    --
    granted_at : TIMESTAMP
    granted_by_member_id : UUID <<FK organization_members.id>>
    ' C-31: project member and role belong to the same project; grantor is authorized
  }

  entity "project_group_roles" as project_group_roles {
    * group_id : UUID <<FK groups.id>>
    * project_role_id : UUID <<FK project_roles.id>>
    --
    granted_at : TIMESTAMP
    granted_by_member_id : UUID <<FK organization_members.id>>
    ' C-02: group.org_id = project_role.project.org_id
    ' Permission is inherited only by active project members in this group
  }

  entity "boards" as boards {
    * id : UUID <<PK>>
    --
    project_id : UUID <<FK projects.id>>
    ' kanban | scrum
    board_type : VARCHAR
    name : VARCHAR
    description : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "board_columns" as board_columns {
    * id : UUID <<PK>>
    --
    board_id : UUID <<FK boards.id>>
    name : VARCHAR
    position : INT
    wip_limit : INT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(board_id, position)
  }

  entity "board_issue_positions" as board_issue_positions {
    * board_id : UUID <<FK boards.id>>
    * issue_id : UUID <<FK issues.id>>
    --
    rank : VARCHAR
    updated_at : TIMESTAMP
    ' A board has its own ordering; issue rank must not be stored globally
    ' C-18: issue.project_id = board.project_id
    ' C-19: issue state must be mapped to a column on this board
    ' UQ(board_id, rank)
  }

  entity "sprints" as sprints {
    * id : UUID <<PK>>
    --
    project_id : UUID <<FK projects.id>>
    board_id : UUID <<FK boards.id>>
    name : VARCHAR
    goal : TEXT
    ' planned | active | closed
    state : VARCHAR
    start_at : TIMESTAMP
    end_at : TIMESTAMP
    closed_at : TIMESTAMP
    created_at : TIMESTAMP
    ' INVARIANT: board.project_id = sprints.project_id
    ' INVARIANT: sprints.board_id should reference scrum board (board_type=scrum)
    ' UQ(board_id) WHERE state=active
  }

  entity "project_components" as project_components {
    * id : UUID <<PK>>
    --
    project_id : UUID <<FK projects.id>>
    name : VARCHAR
    description : TEXT
    lead_member_id : UUID <<FK organization_members.id>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    archived_at : TIMESTAMP
    ' C-34: lead is an active project member or an authorized org admin
  }

  entity "project_versions" as project_versions {
    * id : UUID <<PK>>
    --
    project_id : UUID <<FK projects.id>>
    name : VARCHAR
    description : TEXT
    release_date : TIMESTAMP
    ' unreleased | released | archived
    status : VARCHAR
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    released_at : TIMESTAMP
  }

  entity "permission_schemes" as permission_schemes {
    * id : UUID <<PK>>
    --
    project_id : UUID <<FK projects.id>>
    name : VARCHAR
    description : TEXT
    created_at : TIMESTAMP
  }

  entity "permission_scheme_entries" as permission_scheme_entries {
    * id : UUID <<PK>>
    --
    scheme_id : UUID <<FK permission_schemes.id>>
    ' e.g., CREATE_ISSUE, BROWSE_PROJECT
    permission_key : VARCHAR
    project_role_id : UUID <<FK project_roles.id>>
    ' C-17: project_role_id must belong to same project as permission_scheme
    ' UQ(scheme_id, permission_key, project_role_id)
  }
}

' =========================
' Workflow / FSM
' =========================
package "Workflow (FSM)" {
  entity "workflows" as workflows {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    key : VARCHAR
    name : VARCHAR
    description : TEXT
    version : INT
    is_active : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, key, version); UQ(org_id, key) WHERE is_active=true
    ' key is the stable logical workflow identity across renamed versions
  }

  entity "workflow_states" as workflow_states {
    * id : UUID <<PK>>
    --
    workflow_id : UUID <<FK workflows.id>>
    key : VARCHAR
    name : VARCHAR
    ' todo | in_progress | done
    category : VARCHAR
    is_initial : BOOLEAN
    is_terminal : BOOLEAN
    position : INT
    created_at : TIMESTAMP
    ' UQ(workflow_id, key)
    ' UQ(workflow_id) WHERE is_initial = true
  }

  entity "workflow_transitions" as workflow_transitions {
    * id : UUID <<PK>>
    --
    workflow_id : UUID <<FK workflows.id>>
    key : VARCHAR
    name : VARCHAR
    from_state_id : UUID <<FK workflow_states.id>>
    to_state_id : UUID <<FK workflow_states.id>>
    require_comment : BOOLEAN
    sort_order : INT
    created_at : TIMESTAMP
    ' UQ(workflow_id, key)
    ' C-16: from_state_id and to_state_id must belong to same workflow_id
    ' INVARIANT: (workflow_id, from_state_id) -> workflow_states(workflow_id, id)
    ' INVARIANT: (workflow_id, to_state_id) -> workflow_states(workflow_id, id)
  }

  entity "workflow_transition_guards" as transition_guards {
    * id : UUID <<PK>>
    --
    transition_id : UUID <<FK workflow_transitions.id>>
    ' dsl | json_logic | requires_fields | custom
    guard_type : VARCHAR
    config_json : JSON
    created_at : TIMESTAMP
  }

  entity "workflow_schemes" as workflow_schemes {
    * id : UUID <<PK>>
    --
    project_id : UUID <<FK projects.id>>
    name : VARCHAR
    description : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
  }

  entity "workflow_scheme_mappings" as workflow_scheme_mappings {
    * workflow_scheme_id : UUID <<FK workflow_schemes.id>>
    * issue_type_id : UUID <<FK issue_types.id>>
    --
    workflow_id : UUID <<FK workflows.id>>
    ' C-11: issue_types.org_id = projects.org_id (via scheme.project_id)
    ' C-12: workflows.org_id = projects.org_id (via scheme.project_id)
    ' UQ(workflow_scheme_id, issue_type_id)
  }

  entity "workflow_scheme_transition_permissions" as scheme_transition_permissions {
    * workflow_scheme_id : UUID <<FK workflow_schemes.id>>
    * transition_id : UUID <<FK workflow_transitions.id>>
    * project_role_id : UUID <<FK project_roles.id>>
    --
    ' allow | deny
    effect : VARCHAR
    ' UQ(workflow_scheme_id, transition_id, project_role_id)
    ' project_role must belong to same project as workflow_scheme
    ' C-03: transition must belong to a workflow mapped by workflow_scheme_id
  }

  entity "board_column_states" as board_column_states {
    * board_column_id : UUID <<FK board_columns.id>>
    * workflow_state_id : UUID <<FK workflow_states.id>>
    --
    ' maps a column to one or more states (multi-workflow board: S-07)
    ' states should belong to workflows used in project scheme mappings
    ' C-04: a workflow state can appear in at most one column of the same board
  }
}

' =========================
' Issues / Content
' =========================
package "Issues & Content" {
  entity "issue_types" as issue_types {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    key : VARCHAR
    name : VARCHAR
    description : TEXT
    saved_filter_id : UUID <<FK saved_filters.id>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    archived_at : TIMESTAMP
    ' UQ(org_id, key)
  }

  entity "resolutions" as resolutions {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    ' Fixed | Wont Do | Duplicate | Cannot Reproduce
    name : VARCHAR
    description : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    archived_at : TIMESTAMP
  }

  entity "issues" as issues {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    project_id : UUID <<FK projects.id>>
    issue_type_id : UUID <<FK issue_types.id>>

    workflow_id : UUID <<FK workflows.id>>
    state_id : UUID <<FK workflow_states.id>>
    resolution_id : UUID <<FK resolutions.id>>
    security_level_id : UUID <<FK issue_security_levels.id>>

    ' e.g., PROJ-123
    key : VARCHAR
    summary : VARCHAR
    description : TEXT

    reporter_member_id : UUID <<FK organization_members.id>>
    assignee_member_id : UUID <<FK organization_members.id>>

    parent_issue_id : UUID <<FK issues.id>>
    sprint_id : UUID <<FK sprints.id>>
    component_id : UUID <<FK project_components.id>>
    fix_version_id : UUID <<FK project_versions.id>>

    priority_id : UUID <<FK priorities.id>>
    due_at : TIMESTAMP
    original_estimate_seconds : INT
    remaining_estimate_seconds : INT
    time_spent_seconds : INT

    ' optimistic concurrency
    version : INT

    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    resolved_at : TIMESTAMP
    archived_at : TIMESTAMP
    deleted_at : TIMESTAMP
    ' UQ(project_id, key)
    ' C-13: issues.org_id = projects.org_id (denormalize tenant)
    ' COMPOSITE FK: (workflow_id, state_id) -> workflow_states(workflow_id, id)
    ' INVARIANT: reporter/assignee must be active project members (or an authorized org admin)
    ' INVARIANT: parent_issue_id must be same project, not self, and must not form a cycle
    ' INVARIANT: component_id/fix_version_id must belong to same project_id
    ' INVARIANT: sprint_id must belong to board within same project_id
    ' INVARIANT: issue type/workflow/priority/security level must satisfy selected project schemes
    ' INVARIANT: resolution/resolved_at are set only when current state is terminal
    ' IDX(project_id, state_id)
  }

  entity "work_logs" as work_logs {
    * id : UUID <<PK>>
    --
    issue_id : UUID <<FK issues.id>>
    author_member_id : UUID <<FK organization_members.id>>
    time_spent_seconds : INT
    started_at : TIMESTAMP
    comment : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
    ' C-20: author must be an active project member or an authorized org admin
    ' CHECK(time_spent_seconds > 0)
    ' time_spent_seconds on issues is an atomic cache of non-deleted work logs
  }

  entity "issue_sprint_history" as issue_sprint_history {
    * id : UUID <<PK>>
    --
    issue_id : UUID <<FK issues.id>>
    sprint_id : UUID <<FK sprints.id>>
    added_by_member_id : UUID <<FK organization_members.id>>
    added_at : TIMESTAMP
    ' C-32: sprint actors belong to the same org as issue and are authorized
    removed_by_member_id : UUID <<FK organization_members.id>>
    removed_at : TIMESTAMP
    ' C-05: issue and sprint belong to the same project
    ' UQ(issue_id) WHERE removed_at IS NULL
    ' issues.sprint_id is the current-assignment cache and must match this active row
  }

  entity "issue_link_types" as issue_link_types {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    key : VARCHAR
    ' blocks
    outward_label : VARCHAR
    ' is blocked by
    inward_label : VARCHAR
    ' directed | symmetric
    directionality : VARCHAR
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    archived_at : TIMESTAMP
    ' UQ(org_id, key)
    ' Archived types remain readable but cannot be assigned to new links
  }

  entity "issue_links" as issue_links {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    issue_id : UUID <<FK issues.id>>
    linked_issue_id : UUID <<FK issues.id>>
    link_type_id : UUID <<FK issue_link_types.id>>
    created_by_member_id : UUID <<FK organization_members.id>>
    created_at : TIMESTAMP
    ' UQ(issue_id, linked_issue_id, link_type_id)
    ' C-06: issue_id != linked_issue_id; both issues and link type same org_id
    ' C-07: for symmetric link types, persist pair in canonical ID order
    ' C-15: issue_links.org_id = issues.org_id (denormalize tenant)
  }

  entity "labels" as labels {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    name : VARCHAR
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    archived_at : TIMESTAMP
    ' UQ(org_id, name)
    ' Archived labels remain readable but cannot be newly assigned
  }

  entity "issue_labels" as issue_labels {
    * issue_id : UUID <<FK issues.id>>
    * label_id : UUID <<FK labels.id>>
    --
    added_by_member_id : UUID <<FK organization_members.id>>
    added_at : TIMESTAMP
  }

  entity "issue_watchers" as issue_watchers {
    * issue_id : UUID <<FK issues.id>>
    * org_member_id : UUID <<FK organization_members.id>>
    --
    added_at : TIMESTAMP
    ' C-33: watcher belongs to issue org and can browse the project
  }

  entity "comments" as comments {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    issue_id : UUID <<FK issues.id>>
    author_member_id : UUID <<FK organization_members.id>>
    parent_comment_id : UUID <<FK comments.id>>
    body : TEXT
    ' markdown | plain
    body_format : VARCHAR
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    deleted_at : TIMESTAMP
    ' C-14: comments.org_id = issues.org_id (denormalize tenant)
    ' INVARIANT: parent_comment_id must be in same issue, not self, and not form a cycle
  }

  entity "attachments" as attachments {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    issue_id : UUID <<FK issues.id, NOT NULL>>
    comment_id : UUID <<FK comments.id>>
    uploaded_by_member_id : UUID <<FK organization_members.id>>

    file_name : VARCHAR
    mime_type : VARCHAR
    file_size : BIGINT

    ' local | s3 | gcs | azure_blob
    storage_provider : VARCHAR
    storage_key : VARCHAR
    storage_url : VARCHAR
    checksum : VARCHAR

    created_at : TIMESTAMP
    deleted_at : TIMESTAMP

    ' comment_id is optional; if set, it identifies the comment where file was posted
    ' C-08: comment.issue_id = attachment.issue_id and both belong to attachment.org_id
  }
}

' =========================
' Custom fields (dynamic schema)
' =========================
package "Custom Fields" {
  entity "custom_fields" as custom_fields {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    key : VARCHAR
    name : VARCHAR
    ' text | number | date | select | user | json
    field_type : VARCHAR
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, key)
  }

  entity "custom_field_contexts" as custom_field_contexts {
    * id : UUID <<PK>>
    --
    custom_field_id : UUID <<FK custom_fields.id>>
    project_id : UUID <<FK projects.id>>
    issue_type_id : UUID <<FK issue_types.id>>
    --
    is_required : BOOLEAN
    position : INT
    ' field configuration for a project + issue type
    ' C-09: custom field, project and issue type belong to the same org
    ' UQ(custom_field_id, project_id, issue_type_id)
  }

  entity "custom_field_options" as custom_field_options {
    * id : UUID <<PK>>
    --
    custom_field_id : UUID <<FK custom_fields.id>>
    value : VARCHAR
    label : VARCHAR
    position : INT
    created_at : TIMESTAMP
  }

  entity "issue_custom_field_values" as issue_custom_field_values {
    * issue_id : UUID <<FK issues.id>>
    * custom_field_context_id : UUID <<FK custom_field_contexts.id>>
    --
    value_json : JSON
    updated_at : TIMESTAMP
    ' C-21: issue project and type must match the field context
    ' C-22: value_json must conform to field_type; select values use options of context custom field
  }
}

' =========================
' Audit / Events / Notifications
' =========================
package "Audit & Events" {
  entity "issue_state_history" as issue_state_history {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    issue_id : UUID <<FK issues.id>>

    from_state_id : UUID <<FK workflow_states.id>>
    to_state_id : UUID <<FK workflow_states.id>>
    transition_id : UUID <<FK workflow_transitions.id>>
    transition_comment_id : UUID <<FK comments.id>>

    actor_member_id : UUID <<FK organization_members.id>>

    idempotency_key : VARCHAR
    reason : VARCHAR
    metadata_json : JSON

    issue_version_before : INT
    issue_version_after : INT

    occurred_at : TIMESTAMP
    ' IDX(issue_id, occurred_at)
    ' UQ(issue_id, idempotency_key)
    ' C-10: states/transition belong to issue.workflow; transition_comment belongs to same issue
    ' C-11: transition_comment_id is required when transition.require_comment = true
  }

  entity "activity_logs" as activity_logs {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    ' member | system
    actor_type : VARCHAR
    actor_member_id : UUID <<FK organization_members.id>>
    project_id : UUID <<FK projects.id>>
    issue_id : UUID <<FK issues.id>>
    event_type : VARCHAR
    payload_json : JSON
    created_at : TIMESTAMP
    ' IDX(org_id, created_at)
    ' C-23: member actor belongs to org; actor_member_id is NULL for system actor
    ' when issue and project are both set, issue.project_id = project_id
  }

  entity "outbox_events" as outbox_events {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    ' issue | project | sprint | ...
    aggregate_type : VARCHAR
    aggregate_id : UUID
    event_type : VARCHAR
    payload_json : JSON
    ' pending | published | failed
    status : VARCHAR
    idempotency_key : VARCHAR
    occurred_at : TIMESTAMP
    published_at : TIMESTAMP
    retry_count : INT
    last_error : TEXT
    ' IDX(status, occurred_at)
    ' UQ(org_id, idempotency_key)
    ' idempotency_key is NOT NULL for command-originated events
  }

  entity "notifications" as notifications {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    recipient_member_id : UUID <<FK organization_members.id>>
    outbox_event_id : UUID <<FK outbox_events.id>>

    notification_type : VARCHAR
    title : VARCHAR
    body : TEXT
    data_json : JSON

    sent_at : TIMESTAMP
    read_at : TIMESTAMP
    created_at : TIMESTAMP
    ' IDX(recipient_member_id, read_at)
    ' UQ(outbox_event_id, recipient_member_id, notification_type)
    ' C-24: recipient and outbox event belong to notification.org_id
  }

  entity "notification_preferences" as notification_preferences {
    * org_member_id : UUID <<FK organization_members.id>>
    * notification_type : VARCHAR
    * channel : VARCHAR
    --
    org_id : UUID <<FK organizations.id>>
    enabled : BOOLEAN
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' channel: in_app | email; push requires a device endpoint extension
    ' C-26: member belongs to org_id
  }

  entity "notification_deliveries" as notification_deliveries {
    * id : UUID <<PK>>
    --
    notification_id : UUID <<FK notifications.id>>
    ' email; future external channels: push | chat
    channel : VARCHAR
    destination : VARCHAR
    ' pending | sent | failed | cancelled
    status : VARCHAR
    attempt_count : INT
    last_error : TEXT
    next_attempt_at : TIMESTAMP
    sent_at : TIMESTAMP
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(notification_id, channel)
    ' destination is a snapshot; never store credentials or raw provider secrets
  }

  entity "background_jobs" as background_jobs {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    ' member | system
    requested_by_type : VARCHAR
    requested_by_member_id : UUID <<FK organization_members.id>>
    ' workflow_migration | bulk_issue | export | import | reconciliation
    job_type : VARCHAR
    scope_type : VARCHAR
    scope_id : UUID
    ' queued | running | succeeded | failed | cancelled
    status : VARCHAR
    idempotency_key : VARCHAR
    input_json : JSON
    result_json : JSON
    result_storage_key : VARCHAR
    progress_current : INT
    progress_total : INT
    attempt_count : INT
    next_attempt_at : TIMESTAMP
    lease_owner : VARCHAR
    lease_expires_at : TIMESTAMP
    cancel_requested_at : TIMESTAMP
    started_at : TIMESTAMP
    finished_at : TIMESTAMP
    last_error : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, idempotency_key)
    ' IDX(status, next_attempt_at, lease_expires_at, created_at)
    ' C-27: member requester belongs to org_id; member id is NULL for system jobs
    ' scope ownership is validated by job_type
  }
}

' =========================
' Jira-style Configuration Schemes (Phase 2)
' =========================
package "Configuration Schemes" {
  entity "priorities" as priorities {
    * id : UUID <<PK>>
