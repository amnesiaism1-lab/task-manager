    org_id : UUID <<FK organizations.id>>
    key : VARCHAR
    name : VARCHAR
    description : TEXT
    rank : INT
    color : VARCHAR
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    archived_at : TIMESTAMP
    ' UQ(org_id, key); UQ(org_id, rank)
  }

  entity "priority_schemes" as priority_schemes {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    name : VARCHAR
    description : TEXT
    default_priority_id : UUID <<FK priorities.id>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, name)
  }

  entity "priority_scheme_entries" as priority_scheme_entries {
    * scheme_id : UUID <<FK priority_schemes.id>>
    * priority_id : UUID <<FK priorities.id>>
    --
    position : INT
    ' UQ(scheme_id, position)
    ' C-36: scheme/default/entry priorities belong to the same organization
  }

  entity "issue_type_schemes" as issue_type_schemes {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    name : VARCHAR
    description : TEXT
    default_issue_type_id : UUID <<FK issue_types.id>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, name)
  }

  entity "issue_type_scheme_entries" as issue_type_scheme_entries {
    * scheme_id : UUID <<FK issue_type_schemes.id>>
    * issue_type_id : UUID <<FK issue_types.id>>
    --
    position : INT
    ' UQ(scheme_id, position)
    ' C-37: scheme/default/entry issue types belong to the same organization
  }

  entity "field_schemes" as field_schemes {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    name : VARCHAR
    description : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, name)
  }

  entity "field_scheme_entries" as field_scheme_entries {
    * id : UUID <<PK>>
    --
    scheme_id : UUID <<FK field_schemes.id>>
    issue_type_id : UUID <<FK issue_types.id>>
    field_key : VARCHAR
    custom_field_id : UUID <<FK custom_fields.id>>
    is_required : BOOLEAN
    is_hidden : BOOLEAN
    description_override : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(scheme_id, issue_type_id, field_key)
    ' C-38: issue type/custom field share org with scheme; required and hidden cannot both be true
    ' field_key identifies system fields; custom_field_id is set only for custom fields
  }

  entity "screens" as screens {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    name : VARCHAR
    description : TEXT
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, name)
  }

  entity "screen_fields" as screen_fields {
    * id : UUID <<PK>>
    --
    screen_id : UUID <<FK screens.id>>
    field_key : VARCHAR
    custom_field_id : UUID <<FK custom_fields.id>>
    position : INT
    ' UQ(screen_id, field_key); UQ(screen_id, position)
    ' C-39: custom field belongs to screen org; field key resolves from allowlisted field registry
  }

  entity "screen_schemes" as screen_schemes {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    name : VARCHAR
    description : TEXT
    default_screen_id : UUID <<FK screens.id>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, name)
  }

  entity "screen_scheme_operations" as screen_scheme_operations {
    * scheme_id : UUID <<FK screen_schemes.id>>
    * operation : VARCHAR
    --
    screen_id : UUID <<FK screens.id>>
    ' operation: create | view | edit
    ' C-40: screen/default screen belongs to scheme org; UQ(scheme,operation)
  }

  entity "issue_type_screen_schemes" as issue_type_screen_schemes {
    * id : UUID <<PK>>
    --
    org_id : UUID <<FK organizations.id>>
    name : VARCHAR
    description : TEXT
    default_screen_scheme_id : UUID <<FK screen_schemes.id>>
    created_at : TIMESTAMP
    updated_at : TIMESTAMP
    ' UQ(org_id, name)
  }

  entity "issue_type_screen_scheme_entries" as issue_type_screen_scheme_entries {
    * scheme_id : UUID <<FK issue_type_screen_schemes.id>>
    * issue_type_id : UUID <<FK issue_types.id>>
    --
    screen_scheme_id : UUID <<FK screen_schemes.id>>
    ' C-41: issue type and screen scheme belong to mapping scheme org
  }
}

